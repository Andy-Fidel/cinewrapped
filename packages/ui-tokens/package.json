{
  "name": "@cinewrapped/ui-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node ../../infrastructure/scripts/generate-ui-tokens.mjs",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "lint": "eslint src --no-warn-ignored",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm generate && vitest run src"
  },
  "devDependencies": {
    "@cinewrapped/typescript-config": "workspace:*"
  }
}
