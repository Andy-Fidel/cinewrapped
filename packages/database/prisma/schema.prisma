model Notification {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @db.Uuid
  type        NotificationType
  actorUserId String?                @db.Uuid
  entityType  NotificationEntityType
  entityId    String                 @db.Uuid
  title       String                 @db.VarChar(160)
  body        String                 @db.VarChar(500)
  deepLink    String?                @db.VarChar(1000)
  readAt      DateTime?              @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  deletedAt   DateTime?              @db.Timestamptz(3)

  user       User                   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor      User?                  @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt(sort: Desc), id])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("notifications")
}

model PushDevice {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  installationId String         @db.VarChar(255)
  platform       DevicePlatform
  pushTokenHash  String         @unique @db.VarChar(128)
  encryptedToken String         @db.Text
  locale         String?        @db.VarChar(16)
  timezone       String?        @db.VarChar(64)
  lastSeenAt     DateTime       @db.Timestamptz(3)
  disabledAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId])
  @@index([userId, disabledAt])
  @@map("push_devices")
}

model NotificationDelivery {
  id                String          @id @default(uuid()) @db.Uuid
  notificationId    String          @db.Uuid
  channel           DeliveryChannel
  status            DeliveryStatus  @default(PENDING)
  providerMessageId String?         @db.VarChar(255)
  attemptCount      Int             @default(0)
  lastAttemptAt     DateTime?       @db.Timestamptz(3)
  deliveredAt       DateTime?       @db.Timestamptz(3)
  errorCode         String?         @db.VarChar(100)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

model Achievement {
  id           String          @id @default(uuid()) @db.Uuid
  code         String          @unique @db.VarChar(80)
  name         String          @db.VarChar(120)
  description  String          @db.VarChar(500)
  category     String          @db.VarChar(80)
  iconUrl      String?         @db.VarChar(2048)
  criteriaJson Json            @db.JsonB
  tier         AchievementTier
  points       Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  users UserAchievement[]

  @@index([isActive, category, tier])
  @@map("achievements")
}

model UserAchievement {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  achievementId String    @db.Uuid
  progress      Int       @default(0)
  target        Int
  unlockedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt(sort: Desc)])
  @@map("user_achievements")
}

model Challenge {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique @db.VarChar(80)
  name        String          @db.VarChar(120)
  description String          @db.VarChar(500)
  metric      ChallengeMetric
  target      Int
  points      Int             @default(0)
  startsAt    DateTime        @db.Timestamptz(3)
  endsAt      DateTime        @db.Timestamptz(3)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  users UserChallenge[]

  @@index([isActive, startsAt, endsAt])
  @@map("challenges")
}

model UserChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  challengeId String    @db.Uuid
  progress    Int       @default(0)
  joinedAt    DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)

  @@unique([userId, challengeId])
  @@index([challengeId, completedAt, userId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("user_challenges")
}

model Wrap {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @db.Uuid
  wrapType        WrapType
  periodStart     DateTime   @db.Timestamptz(3)
  periodEnd       DateTime   @db.Timestamptz(3)
  timezone        String     @db.VarChar(64)
  status          WrapStatus @default(PENDING)
  inputVersion    Int        @default(1)
  statisticsJson  Json?      @db.JsonB
  highlightsJson  Json?      @db.JsonB
  storySlidesJson Json?      @db.JsonB
  shareImageUrl   String?    @db.VarChar(2048)
  failureCode     String?    @db.VarChar(100)
  generatedAt     DateTime?  @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?  @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wrapType, periodStart, periodEnd, inputVersion])
  @@index([userId, periodEnd(sort: Desc), id])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("wraps")
}

model Recommendation {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  mediaId            String             @db.Uuid
  score              Decimal            @db.Decimal(7, 6)
  recommendationType RecommendationType
  explanation        String             @db.VarChar(500)
  reasonCodes        String[]           @default([])
  contextJson        Json               @default("{}") @db.JsonB
  modelVersion       String             @db.VarChar(64)
  generatedAt        DateTime           @db.Timestamptz(3)
  expiresAt          DateTime           @db.Timestamptz(3)
  dismissedAt        DateTime?          @db.Timestamptz(3)
  viewedAt           DateTime?          @db.Timestamptz(3)
  selectedAt         DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)

  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media    Media                    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  feedback RecommendationFeedback[]

  @@unique([userId, mediaId, recommendationType, modelVersion, generatedAt])
  @@index([userId, recommendationType, expiresAt, score(sort: Desc)])
  @@index([userId, dismissedAt, expiresAt, score(sort: Desc)])
  @@index([mediaId, generatedAt(sort: Desc)])
  @@map("recommendations")
}

model RecommendationFeedback {
  id               String                     @id @default(uuid()) @db.Uuid
  recommendationId String                     @db.Uuid
  feedbackType     RecommendationFeedbackType
  createdAt        DateTime                   @default(now()) @db.Timestamptz(3)

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, feedbackType])
  @@index([feedbackType, createdAt(sort: Desc)])
  @@map("recommendation_feedback")
}

model UserRoleAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  role        AdminRole
  grantedById String?   @db.Uuid
  grantedAt   DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)

  user      User  @relation("RoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([role, revokedAt])
  @@map("user_role_assignments")
}

model AuditLog {
  id            String         @id @default(uuid()) @db.Uuid
  occurredAt    DateTime       @default(now()) @db.Timestamptz(3)
  actorType     AuditActorType
  actorUserId   String?        @db.Uuid
  actorSubject  String?        @db.VarChar(255)
  action        String         @db.VarChar(120)
  targetType    String         @db.VarChar(120)
  targetId      String?        @db.Uuid
  requestId     String?        @db.VarChar(100)
  ipHash        String?        @db.VarChar(128)
  userAgentHash String?        @db.VarChar(128)
  reason        String?        @db.VarChar(500)
  metadataJson  Json           @default("{}") @db.JsonB

  actorUser User? @relation("AuditUserActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([targetType, targetId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@index([requestId])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @db.VarChar(100)
  aggregateId   String       @db.Uuid
  eventType     String       @db.VarChar(160)
  eventVersion  Int          @default(1)
  payloadJson   Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  availableAt   DateTime     @default(now()) @db.Timestamptz(3)
  lockedAt      DateTime?    @db.Timestamptz(3)
  publishedAt   DateTime?    @db.Timestamptz(3)
  lastErrorCode String?      @db.VarChar(100)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([publishedAt])
  @@map("outbox_events")
}

model FeatureFlag {
  key               String                    @id @db.VarChar(80)
  description       String                    @db.VarChar(500)
  enabled           Boolean                   @default(false)
  rolloutPercentage Int                       @default(0)
  environments      String[]                  @default([])
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)
  overrides         UserFeatureFlagOverride[]

  @@index([enabled])
  @@map("feature_flags")
}

model UserFeatureFlagOverride {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  featureKey String    @db.VarChar(80)
  enabled    Boolean
  expiresAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature FeatureFlag @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([userId, featureKey])
  @@index([expiresAt])
  @@map("user_feature_flag_overrides")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  idempotencyKey String            @db.VarChar(128)
  requestMethod  String            @db.VarChar(10)
  requestPath    String            @db.VarChar(500)
  requestHash    String            @db.VarChar(128)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseJson   Json?             @db.JsonB
  errorCode      String?           @db.VarChar(100)
  expiresAt      DateTime          @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([expiresAt])
  @@index([status, createdAt])
  @@map("idempotency_records")
}
