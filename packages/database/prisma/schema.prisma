generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum ContentVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
  CLUB_ONLY
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum SpoilerPreference {
  ALWAYS_HIDE
  HIDE_UNTIL_REVEALED
  SHOW
}

enum RatingSystem {
  FIVE_STAR
  TEN_POINT
  LIKE_DISLIKE
}

enum ContentType {
  MOVIE
  TV
  ANIME
  DOCUMENTARY
  SHORT_FILM
}

enum GenrePreferenceType {
  PREFERRED
  DISLIKED
}

enum OnboardingStep {
  PROFILE
  CONTENT_TYPES
  GENRES
  FAVORITES
  DISLIKES
  STREAMING
  RECOMMENDATIONS
  SOCIAL
  NOTIFICATIONS
}

enum SessionPlatform {
  IOS
  ANDROID
  WEB
  UNKNOWN
}

enum MediaType {
  MOVIE
  TV
}

enum ExternalProvider {
  TMDB
}

enum MediaStatus {
  RUMORED
  PLANNED
  IN_PRODUCTION
  POST_PRODUCTION
  RELEASED
  RETURNING_SERIES
  ENDED
  CANCELED
  UNKNOWN
}

enum CreditType {
  CAST
  CREW
}

enum StreamingMonetizationType {
  FLATRATE
  FREE
  ADS
  RENT
  BUY
}

enum WatchStatus {
  PLANNED
  WATCHING
  COMPLETED
  PAUSED
  DROPPED
  REWATCHING
}

enum WatchSource {
  MANUAL
  IMPORT
  API
  OFFLINE_SYNC
}

enum ReviewStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  REMOVED
}

enum FollowStatus {
  ACTIVE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum ClubVisibility {
  PUBLIC
  PRIVATE
}

enum ClubMembershipType {
  OPEN
  APPROVAL
  INVITE_ONLY
}

enum ClubRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum ClubMemberStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum ClubPostType {
  DISCUSSION
  ANNOUNCEMENT
}

enum ClubPollStatus {
  OPEN
  CLOSED
}

enum ClubWatchEventStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum FeedActivityType {
  USER_WATCHED_MEDIA
  USER_RATED_MEDIA
  USER_REVIEWED_MEDIA
  USER_CREATED_LIST
  USER_UNLOCKED_ACHIEVEMENT
  USER_JOINED_CLUB
  USER_SHARED_WRAP
}

enum ActivityEntityType {
  VIEWING
  RATING
  REVIEW
  WATCHLIST
  COLLECTION
  ACHIEVEMENT
  CLUB
  WRAP
}

enum CommentParentType {
  REVIEW
  WATCHLIST
  COLLECTION
  FEED_ACTIVITY
  CLUB_POST
  WRAP
}

enum ReactionTargetType {
  REVIEW
  COMMENT
  WATCHLIST
  COLLECTION
  FEED_ACTIVITY
  CLUB_POST
  WRAP
}

enum ReactionType {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_REQUEST_ACCEPTED
  COMMENT
  REACTION
  NEW_FOLLOWER
  WRAP_READY
  ACHIEVEMENT_UNLOCKED
  SHARED_TITLE
}

enum NotificationEntityType {
  USER
  FRIENDSHIP
  COMMENT
  REACTION
  REVIEW
  MEDIA
  WRAP
  ACHIEVEMENT
}

enum DeliveryChannel {
  IN_APP
  PUSH
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum AchievementTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum ChallengeMetric {
  VIEWINGS
  UNIQUE_TITLES
  MINUTES_WATCHED
  REWATCHES
  RATINGS
  REVIEWS
  STREAK_DAYS
  COUNTRIES
}

enum WrapType {
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum WrapStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum RecommendationType {
  PERSONALIZED
  TRENDING
  FRIEND_BASED
  MOOD_BASED
  SIMILAR_MEDIA
  HIDDEN_GEM
  CONTINUE_WATCHING
  BECAUSE_YOU_WATCHED
}

enum RecommendationFeedbackType {
  VIEWED
  SAVED
  DISMISSED
  SELECTED
}

enum AdminRole {
  SUPER_ADMINISTRATOR
  CONTENT_MODERATOR
  COMMUNITY_MODERATOR
  SUPPORT_AGENT
  ANALYST
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum JournalEntryStatus {
  DRAFT
  COMPLETED
}

enum JournalAttachmentType {
  TICKET
  PERSONAL_PHOTO
}

enum CalendarEventType {
  WATCH_PLAN
  RELEASE_REMINDER
}

enum CalendarEventStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum MusicProvider {
  APPLE_MUSIC
}

enum SceneIdentificationStatus {
  MATCHED
  UNCERTAIN
  NO_MATCH
}

enum SceneIdentificationFeedback {
  PENDING
  CONFIRMED
  REJECTED
}

model User {
  id                  String            @id @default(uuid()) @db.Uuid
  authProvider        String            @default("supabase") @db.VarChar(32)
  authSubject         String            @unique @db.VarChar(255)
  email               String            @db.VarChar(320)
  emailNormalized     String            @unique @db.VarChar(320)
  username            String            @db.VarChar(30)
  usernameNormalized  String            @unique @db.VarChar(30)
  displayName         String            @db.VarChar(80)
  avatarUrl           String?           @db.VarChar(2048)
  bio                 String?           @db.VarChar(500)
  countryCode         String            @db.Char(2)
  preferredLanguage   String            @db.VarChar(16)
  timezone            String            @db.VarChar(64)
  dateOfBirth         DateTime?         @db.Date
  profileVisibility   ProfileVisibility @default(PRIVATE)
  onboardingCompleted Boolean           @default(false)
  recommendationOptIn Boolean           @default(true)
  analyticsOptIn      Boolean           @default(false)
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?         @db.Timestamptz(3)

  preferences               UserPreferences?
  privacySettings           PrivacySettings?
  onboardingProgress        OnboardingProgress?
  authSessions              AuthSession[]
  genrePreferences          UserGenrePreference[]
  favoriteMedia             UserFavoriteMedia[]
  streamingPreferences      UserStreamingPreference[]
  watchHistory              WatchHistory[]
  viewings                  Viewing[]
  episodeWatchHistory       EpisodeWatchHistory[]
  viewingCompanionsAsFriend ViewingCompanion[]        @relation("ViewingFriend")
  watchlists                Watchlist[]
  watchlistItemsAdded       WatchlistItem[]
  ratings                   Rating[]
  reviews                   Review[]
  journalEntries            JournalEntry[]
  calendarEvents            CalendarEvent[]
  soundtrackSaves           SoundtrackSave[]
  sceneIdentifications      SceneIdentification[]
  searchHistory             SearchHistory[]
  outgoingFollows           Follow[]                  @relation("FollowFollower")
  incomingFollows           Follow[]                  @relation("FollowFollowing")
  friendshipsAsA            Friendship[]              @relation("FriendshipUserA")
  friendshipsAsB            Friendship[]              @relation("FriendshipUserB")
  friendshipsRequested      Friendship[]              @relation("FriendshipRequester")
  friendshipsAddressed      Friendship[]              @relation("FriendshipAddressee")
  blocksCreated             UserBlock[]               @relation("Blocker")
  blocksReceived            UserBlock[]               @relation("Blocked")
  mutesCreated              UserMute[]                @relation("Muter")
  mutesReceived             UserMute[]                @relation("Muted")
  feedActivities            FeedActivity[]
  comments                  Comment[]
  reactions                 Reaction[]
  notifications             Notification[]            @relation("NotificationRecipient")
  notificationActions       Notification[]            @relation("NotificationActor")
  pushDevices               PushDevice[]
  achievements              UserAchievement[]
  challenges                UserChallenge[]
  wraps                     Wrap[]
  recommendations           Recommendation[]
  roles                     UserRoleAssignment[]      @relation("RoleSubject")
  rolesGranted              UserRoleAssignment[]      @relation("RoleGrantor")
  auditLogs                 AuditLog[]                @relation("AuditUserActor")
  idempotencyRecords        IdempotencyRecord[]
  featureFlagOverrides      UserFeatureFlagOverride[]
  clubsOwned                Club[]                    @relation("ClubOwner")
  clubMemberships           ClubMember[]
  clubPosts                 ClubPost[]
  clubPollsCreated          ClubPoll[]
  clubPollVotes             ClubPollVote[]
  clubWatchlistSuggestions  ClubWatchlistItem[]
  clubWatchlistVotes        ClubWatchlistVote[]
  clubWatchEventsCreated    ClubWatchEvent[]

  @@index([deletedAt])
  @@index([createdAt, id])
  @@map("users")
}

model AuthSession {
  id             String          @id @db.VarChar(255)
  userId         String          @db.Uuid
  installationId String?         @db.VarChar(255)
  platform       SessionPlatform @default(UNKNOWN)
  deviceName     String?         @db.VarChar(120)
  userAgent      String?         @db.VarChar(500)
  ipAddressHash  String?         @db.Char(64)
  expiresAt      DateTime?       @db.Timestamptz(3)
  lastSeenAt     DateTime        @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, lastSeenAt(sort: Desc)])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model OnboardingProgress {
  userId                 String           @id @db.Uuid
  currentStep            OnboardingStep   @default(PROFILE)
  completedSteps         OnboardingStep[] @default([])
  acceptedPrivacyVersion String?          @db.VarChar(40)
  acceptedTermsVersion   String?          @db.VarChar(40)
  completedAt            DateTime?        @db.Timestamptz(3)
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentStep, updatedAt])
  @@map("onboarding_progress")
}

model UserPreferences {
  userId                      String            @id @db.Uuid
  preferredLanguages          String[]          @default([])
  preferredCountries          String[]          @default([])
  preferredDecades            Int[]             @default([])
  preferredRuntimeMin         Int?
  preferredRuntimeMax         Int?
  preferredRatingSystem       RatingSystem      @default(FIVE_STAR)
  contentTypes                ContentType[]     @default([MOVIE, TV])
  spoilerPreference           SpoilerPreference @default(HIDE_UNTIL_REVEALED)
  adultContentEnabled         Boolean           @default(false)
  notificationPreferences     Json              @default("{}") @db.JsonB
  theme                       ThemePreference   @default(SYSTEM)
  defaultCountryForStreaming  String            @db.Char(2)
  autoplayTrailers            Boolean           @default(false)
  reduceMotion                Boolean           @default(false)
  mainstreamPreferencePercent Int               @default(50)
  createdAt                   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime          @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserGenrePreference {
  userId         String              @db.Uuid
  genreId        String              @db.Uuid
  preferenceType GenrePreferenceType
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([userId, genreId])
  @@index([genreId, preferenceType, userId])
  @@map("user_genre_preferences")
}

model PrivacySettings {
  userId                   String            @id @db.Uuid
  watchHistoryVisibility   ContentVisibility @default(PRIVATE)
  ratingsVisibility        ContentVisibility @default(FRIENDS)
  reviewsVisibility        ContentVisibility @default(PUBLIC)
  listsVisibility          ContentVisibility @default(FRIENDS)
  friendListVisibility     ContentVisibility @default(FRIENDS)
  wrapsVisibility          ContentVisibility @default(PRIVATE)
  onlineStatusVisibility   ContentVisibility @default(PRIVATE)
  shareWatchActivity       Boolean           @default(false)
  shareRatingActivity      Boolean           @default(false)
  shareReviewActivity      Boolean           @default(false)
  shareListActivity        Boolean           @default(false)
  shareAchievementActivity Boolean           @default(false)
  leaderboardVisibility    ContentVisibility @default(PRIVATE)
  passportVisibility       ContentVisibility @default(PRIVATE)
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

model Genre {
  id         String           @id @default(uuid()) @db.Uuid
  provider   ExternalProvider
  externalId String           @db.VarChar(64)
  name       String           @db.VarChar(80)
  slug       String           @unique @db.VarChar(100)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)

  media           MediaGenre[]
  userPreferences UserGenrePreference[]

  @@unique([provider, externalId])
  @@map("genres")
}

model Media {
  id                    String           @id @default(uuid()) @db.Uuid
  externalProvider      ExternalProvider
  externalId            String           @db.VarChar(64)
  mediaType             MediaType
  title                 String           @db.VarChar(300)
  originalTitle         String           @db.VarChar(300)
  overview              String?          @db.Text
  releaseDate           DateTime?        @db.Date
  releaseYear           Int?
  runtimeMinutes        Int?
  originalLanguage      String?          @db.VarChar(16)
  countryCodes          String[]         @default([])
  posterUrl             String?          @db.VarChar(2048)
  backdropUrl           String?          @db.VarChar(2048)
  trailerUrl            String?          @db.VarChar(2048)
  status                MediaStatus      @default(UNKNOWN)
  averageProviderRating Decimal?         @db.Decimal(4, 2)
  providerPopularity    Decimal?         @db.Decimal(12, 4)
  ageRating             String?          @db.VarChar(32)
  metadataJson          Json             @default("{}") @db.JsonB
  lastSyncedAt          DateTime?        @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)

  genres                MediaGenre[]
  credits               Credit[]
  productionCompanies   MediaProductionCompany[]
  seasons               TvSeason[]
  streamingAvailability MediaStreamingAvailability[]
  favoriteOf            UserFavoriteMedia[]
  watchHistory          WatchHistory[]
  viewings              Viewing[]
  watchlistItems        WatchlistItem[]
  ratings               Rating[]
  reviews               Review[]
  journalEntries        JournalEntry[]
  calendarEvents        CalendarEvent[]
  soundtrackSaves       SoundtrackSave[]
  identifiedScenes      SceneIdentification[]
  feedActivities        FeedActivity[]
  recommendations       Recommendation[]
  clubPollOptions       ClubPollOption[]
  clubWatchlistItems    ClubWatchlistItem[]
  clubWatchEvents       ClubWatchEvent[]

  @@unique([externalProvider, externalId, mediaType])
  @@index([mediaType, providerPopularity(sort: Desc)])
  @@index([mediaType, releaseDate(sort: Desc)])
  @@index([lastSyncedAt])
  @@index([title])
  @@map("media")
}

model MediaGenre {
  mediaId String @db.Uuid
  genreId String @db.Uuid

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([mediaId, genreId])
  @@index([genreId, mediaId])
  @@map("media_genres")
}

model Person {
  id               String           @id @default(uuid()) @db.Uuid
  externalProvider ExternalProvider
  externalId       String           @db.VarChar(64)
  name             String           @db.VarChar(200)
  profileUrl       String?          @db.VarChar(2048)
  metadataJson     Json             @default("{}") @db.JsonB
  lastSyncedAt     DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  credits Credit[]

  @@unique([externalProvider, externalId])
  @@index([name])
  @@map("people")
}

model Credit {
  id         String     @id @default(uuid()) @db.Uuid
  mediaId    String     @db.Uuid
  personId   String     @db.Uuid
  creditType CreditType
  department String?    @db.VarChar(100)
  job        String?    @db.VarChar(120)
  character  String?    @db.VarChar(300)
  position   Int?
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)

  media  Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([mediaId, personId, creditType, job, character])
  @@index([personId, creditType, mediaId])
  @@index([mediaId, creditType, position])
  @@map("credits")
}

model ProductionCompany {
  id               String           @id @default(uuid()) @db.Uuid
  externalProvider ExternalProvider
  externalId       String           @db.VarChar(64)
  name             String           @db.VarChar(200)
  logoUrl          String?          @db.VarChar(2048)
  countryCode      String?          @db.Char(2)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  media MediaProductionCompany[]

  @@unique([externalProvider, externalId])
  @@map("production_companies")
}

model MediaProductionCompany {
  mediaId   String @db.Uuid
  companyId String @db.Uuid

  media   Media             @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  company ProductionCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([mediaId, companyId])
  @@index([companyId, mediaId])
  @@map("media_production_companies")
}

model TvSeason {
  id               String           @id @default(uuid()) @db.Uuid
  mediaId          String           @db.Uuid
  externalProvider ExternalProvider
  externalId       String           @db.VarChar(64)
  seasonNumber     Int
  name             String           @db.VarChar(200)
  overview         String?          @db.Text
  airDate          DateTime?        @db.Date
  episodeCount     Int?
  posterUrl        String?          @db.VarChar(2048)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  media    Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  episodes TvEpisode[]

  @@unique([mediaId, seasonNumber])
  @@unique([externalProvider, externalId])
  @@index([mediaId, seasonNumber])
  @@map("tv_seasons")
}

model TvEpisode {
  id               String           @id @default(uuid()) @db.Uuid
  seasonId         String           @db.Uuid
  externalProvider ExternalProvider
  externalId       String           @db.VarChar(64)
  episodeNumber    Int
  name             String           @db.VarChar(200)
  overview         String?          @db.Text
  airDate          DateTime?        @db.Date
  runtimeMinutes   Int?
  stillUrl         String?          @db.VarChar(2048)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  season       TvSeason              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchHistory EpisodeWatchHistory[]

  @@unique([seasonId, episodeNumber])
  @@unique([externalProvider, externalId])
  @@index([seasonId, episodeNumber])
  @@map("tv_episodes")
}

model StreamingProvider {
  id               String           @id @default(uuid()) @db.Uuid
  externalProvider ExternalProvider
  externalId       String           @db.VarChar(64)
  name             String           @db.VarChar(120)
  slug             String           @unique @db.VarChar(140)
  logoUrl          String?          @db.VarChar(2048)
  displayPriority  Int?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  availability    MediaStreamingAvailability[]
  userPreferences UserStreamingPreference[]

  @@unique([externalProvider, externalId])
  @@map("streaming_providers")
}

model MediaStreamingAvailability {
  id                  String                    @id @default(uuid()) @db.Uuid
  mediaId             String                    @db.Uuid
  streamingProviderId String                    @db.Uuid
  countryCode         String                    @db.Char(2)
  monetizationType    StreamingMonetizationType
  providerUrl         String?                   @db.VarChar(2048)
  displayPriority     Int?
  fetchedAt           DateTime                  @db.Timestamptz(3)
  expiresAt           DateTime                  @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)

  media             Media             @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  streamingProvider StreamingProvider @relation(fields: [streamingProviderId], references: [id], onDelete: Cascade)

  @@unique([mediaId, streamingProviderId, countryCode, monetizationType])
  @@index([countryCode, streamingProviderId, monetizationType, mediaId])
  @@index([expiresAt])
  @@map("media_streaming_availability")
}

model UserFavoriteMedia {
  userId    String   @db.Uuid
  mediaId   String   @db.Uuid
  position  Int?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
  @@unique([userId, position])
  @@index([userId, position])
  @@map("user_favorite_media")
}

model UserStreamingPreference {
  userId              String   @db.Uuid
  streamingProviderId String   @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  streamingProvider StreamingProvider @relation(fields: [streamingProviderId], references: [id], onDelete: Cascade)

  @@id([userId, streamingProviderId])
  @@index([streamingProviderId, userId])
  @@map("user_streaming_preferences")
}

model WatchHistory {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  mediaId         String      @db.Uuid
  status          WatchStatus @default(PLANNED)
  startedAt       DateTime?   @db.Timestamptz(3)
  completedAt     DateTime?   @db.Timestamptz(3)
  progressPercent Decimal     @default(0) @db.Decimal(5, 2)
  progressSeconds Int?
  watchCount      Int         @default(0)
  lastWatchedAt   DateTime?   @db.Timestamptz(3)
  version         Int         @default(1)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media    Media     @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  viewings Viewing[]

  @@unique([userId, mediaId])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([userId, lastWatchedAt(sort: Desc)])
  @@index([mediaId, status])
  @@map("watch_history")
}

model Viewing {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @db.Uuid
  mediaId            String      @db.Uuid
  watchHistoryId     String      @db.Uuid
  clientOperationId  String?     @db.Uuid
  watchedAt          DateTime    @db.Timestamptz(3)
  completedAt        DateTime?   @db.Timestamptz(3)
  durationWatchedMin Int?
  viewingPlatform    String?     @db.VarChar(120)
  viewingLocation    String?     @db.VarChar(200)
  source             WatchSource @default(MANUAL)
  notes              String?     @db.Text
  isRewatch          Boolean     @default(false)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?   @db.Timestamptz(3)

