{
  "expo": {
    "name": "CineWrapped",
    "slug": "cinewrapped",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cinewrapped",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store", "expo-image-picker", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cinewrapped.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "CineWrapped uses your camera to identify film scenes from screens, posters, and physical cinema tickets.",
        "NSPhotoLibraryUsageDescription": "CineWrapped accesses your photo library so you can choose avatar profile photos and analyze saved film stills.",
        "NSCalendarsUsageDescription": "CineWrapped syncs movie premiere countdowns and festival watch schedules to your iOS Calendar."
      }
    },
    "android": {
      "package": "com.cinewrapped.app",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F19"
      }
    },
    "web": {
      "favicon": "./assets/logo-mark.png",
      "bundler": "metro",
      "output": "static"
    }
  }
}
