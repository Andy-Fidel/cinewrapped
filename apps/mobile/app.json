{
  "expo": {
    "name": "CineWrapped",
    "slug": "cinewrapped",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cinewrapped",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store", "expo-image-picker", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cinewrapped.app"
    },
    "android": {
      "package": "com.cinewrapped.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
