{
  "expo": {
    "name": "CineWrapped",
    "slug": "cinewrapped",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cinewrapped",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cinewrapped.app"
    },
    "android": {
      "package": "com.cinewrapped.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
