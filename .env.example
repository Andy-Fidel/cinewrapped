# Shared environment
NODE_ENV=development
LOG_LEVEL=debug

# API
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
TRUST_PROXY=false
# API_DOCS_ENABLED defaults to true outside production and false in production.
API_DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
DATABASE_URL=postgresql://cinewrapped:cinewrapped_local@localhost:5432/cinewrapped?schema=public
DIRECT_DATABASE_URL=postgresql://cinewrapped:cinewrapped_local@localhost:5432/cinewrapped?schema=public
REDIS_URL=redis://localhost:6379
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Server-only secret key used for account erasure. Never expose this as EXPO_PUBLIC_*.
SUPABASE_SECRET_KEY=replace-with-server-only-supabase-secret-key
TMDB_API_TOKEN=replace-with-local-development-token
OPENAI_API_KEY=replace-with-an-openai-project-api-key
OPENAI_VISION_MODEL=gpt-5.4-mini
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cinewrapped-local
S3_ACCESS_KEY=cinewrapped
S3_SECRET_KEY=replace-with-a-long-local-secret
EXPO_ACCESS_TOKEN=replace-only-when-local-push-testing-is-needed
SENTRY_DSN=
POSTHOG_API_KEY=
# Optional dedicated secret for AES-256-GCM push-token encryption. Falls back to a
# domain-separated derivation of S3_SECRET_KEY when omitted.
PUSH_TOKEN_ENCRYPTION_KEY=

# Worker
WORKER_CONCURRENCY=4
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

# Admin
ADMIN_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Mobile values are public build-time configuration, never secrets
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-4000-8000-000000000000

# Local Docker services
POSTGRES_DB=cinewrapped
POSTGRES_USER=cinewrapped
POSTGRES_PASSWORD=cinewrapped_local
MINIO_ROOT_USER=cinewrapped
MINIO_ROOT_PASSWORD=replace-with-a-long-local-secret
