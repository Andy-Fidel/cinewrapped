FROM node:22.14-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
WORKDIR /workspace

FROM base AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/worker/package.json apps/worker/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/jobs/package.json packages/jobs/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
RUN --mount=type=cache,id=cinewrapped-pnpm,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && pnpm install --frozen-lockfile

FROM dependencies AS builder
COPY turbo.json eslint.config.mjs ./
COPY apps/worker apps/worker
COPY packages/config packages/config
COPY packages/database packages/database
COPY packages/eslint-config packages/eslint-config
COPY packages/jobs packages/jobs
COPY packages/typescript-config packages/typescript-config
RUN pnpm --filter @cinewrapped/worker... build

FROM node:22.14-alpine AS runner
ENV NODE_ENV=production
WORKDIR /workspace
RUN addgroup --system --gid 1001 cinewrapped && adduser --system --uid 1001 --ingroup cinewrapped cinewrapped
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/node_modules ./node_modules
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/apps/worker/package.json ./apps/worker/package.json
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/apps/worker/dist ./apps/worker/dist
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/config/node_modules ./packages/config/node_modules
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/config/package.json ./packages/config/package.json
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/config/dist ./packages/config/dist
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/database/node_modules ./packages/database/node_modules
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/database/package.json ./packages/database/package.json
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/database/dist ./packages/database/dist
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/jobs/node_modules ./packages/jobs/node_modules
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/jobs/package.json ./packages/jobs/package.json
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/jobs/dist ./packages/jobs/dist
USER cinewrapped
CMD ["node", "apps/worker/dist/main.js"]
