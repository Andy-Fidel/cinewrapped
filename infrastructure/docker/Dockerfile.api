FROM node:22.14-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
WORKDIR /workspace

FROM base AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
COPY packages/validation/package.json packages/validation/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
RUN --mount=type=cache,id=cinewrapped-pnpm,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && pnpm install --frozen-lockfile

FROM dependencies AS builder
COPY turbo.json eslint.config.mjs ./
COPY apps/api apps/api
COPY packages/config packages/config
COPY packages/database packages/database
COPY packages/eslint-config packages/eslint-config
COPY packages/shared-types packages/shared-types
COPY packages/typescript-config packages/typescript-config
COPY packages/validation packages/validation
RUN pnpm --filter @cinewrapped/api... build

FROM node:22.14-alpine AS runner
ENV NODE_ENV=production
WORKDIR /workspace
RUN addgroup --system --gid 1001 cinewrapped && adduser --system --uid 1001 --ingroup cinewrapped cinewrapped
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/node_modules ./node_modules
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/config/node_modules ./packages/config/node_modules
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/config/package.json ./packages/config/package.json
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/config/dist ./packages/config/dist
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/database/package.json ./packages/database/package.json
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/database/node_modules ./packages/database/node_modules
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/database/dist ./packages/database/dist
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/database/prisma ./packages/database/prisma
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/shared-types/package.json ./packages/shared-types/package.json
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/validation/node_modules ./packages/validation/node_modules
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/validation/package.json ./packages/validation/package.json
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/packages/validation/dist ./packages/validation/dist
USER cinewrapped
EXPOSE 4000
CMD ["sh", "-c", "./packages/database/node_modules/.bin/prisma migrate deploy --schema packages/database/prisma/schema.prisma && ./node_modules/.bin/tsx packages/database/prisma/seed.ts && exec node apps/api/dist/main.js"]
