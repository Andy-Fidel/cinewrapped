FROM node:22.14-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
WORKDIR /workspace

FROM base AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json apps/admin/package.json
COPY packages/ui-tokens/package.json packages/ui-tokens/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
RUN pnpm install --frozen-lockfile

FROM dependencies AS builder
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
COPY turbo.json eslint.config.mjs ./
COPY apps/admin apps/admin
COPY docs/design/design-tokens.json docs/design/design-tokens.json
COPY infrastructure/scripts/generate-ui-tokens.mjs infrastructure/scripts/generate-ui-tokens.mjs
COPY packages/eslint-config packages/eslint-config
COPY packages/typescript-config packages/typescript-config
COPY packages/ui-tokens packages/ui-tokens
RUN pnpm --filter @cinewrapped/admin... build

FROM node:22.14-alpine AS runner
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
WORKDIR /app
RUN addgroup --system --gid 1001 cinewrapped && adduser --system --uid 1001 --ingroup cinewrapped cinewrapped
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/apps/admin/.next/standalone ./
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=builder --chown=cinewrapped:cinewrapped /workspace/apps/admin/public ./apps/admin/public
USER cinewrapped
EXPOSE 3000
CMD ["node", "apps/admin/server.js"]
