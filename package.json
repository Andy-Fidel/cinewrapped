{
  "name": "cinewrapped",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered social movie and television tracking platform.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @cinewrapped/database db:generate",
    "db:validate": "pnpm --filter @cinewrapped/database db:validate",
    "db:migrate": "pnpm --filter @cinewrapped/database db:migrate",
    "db:migrate:dev": "pnpm --filter @cinewrapped/database db:migrate:dev",
    "db:seed": "pnpm --filter @cinewrapped/database db:seed",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm db:validate && pnpm build"
  },
  "devDependencies": {
    "@babel/traverse": "^7.29.8",
    "@eslint/js": "9.39.3",
    "@types/node": "24.13.3",
    "eslint": "9.39.3",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "turbo": "2.10.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
